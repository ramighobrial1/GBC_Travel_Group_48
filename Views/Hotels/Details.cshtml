@model GBC_Travel_Group_48.Models.Hotel

@{
    ViewData["Title"] = "Hotel Details";
}

<div class="container mt-4">
    <h2>Hotel Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Hotel Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>

        <dt class="col-sm-2">Star Rating</dt>
        <dd class="col-sm-10">
            @for (int i = 0; i < Model.StarRating; i++)
            {
                <span>⭐</span>
            }
        </dd>

        <dt class="col-sm-2">Price Per Night</dt>
        <dd class="col-sm-10">$@Model.PricePerNight.ToString("N2")</dd>
    </dl>
    <div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>