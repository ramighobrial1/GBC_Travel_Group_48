@model IEnumerable<GBC_Travel_Group_48.Models.Hotel>

@{
    ViewData["Title"] = "Available Hotels";
}

<div class="container mt-4">
    <h2>Available Hotels</h2>
    <p class="text-muted">Explore our curated collection of comfortable hotel stays.</p>
    
    <!-- Add New Hotel Button -->
    <!-- Search Form -->
    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Search by name or location..." />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
    <p>
        <a asp-action="Create" class="btn btn-success">Add New Hotel</a>
    </p>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
        <tr>
            <th>Hotel Name</th>
            <th>Location</th>
            <th>Star Rating</th>
            <th>Price Per Night</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.Name</td>
                <td>@hotel.Location</td>
                <td>
                    @for (int i = 0; i < hotel.StarRating; i++)
                    {
                        <span>⭐</span>
                    }
                </td>
                <td>$@hotel.PricePerNight.ToString("N2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@hotel.HotelId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@hotel.HotelId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@hotel.HotelId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>