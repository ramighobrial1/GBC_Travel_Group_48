@model GBC_Travel_Group_48.Models.Flight

@{
    ViewData["Title"] = "Delete Flight";
}

<div class="container mt-4">
    <h2>Delete Flight</h2>
    <h3 class="text-danger">Are you sure you want to delete this?</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Airline</dt>
        <dd class="col-sm-10">@Model.Airline</dd>

        <dt class="col-sm-2">Flight #</dt>
        <dd class="col-sm-10">@Model.FlightNumber</dd>

        <dt class="col-sm-2">Origin</dt>
        <dd class="col-sm-10">@Model.Origin</dd>

        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">$@Model.Price.ToString("N2")</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="FlightId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>