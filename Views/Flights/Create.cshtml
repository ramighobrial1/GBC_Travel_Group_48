@model GBC_Travel_Group_48.Models.Flight

@{
    ViewData["Title"] = "Add Flight";
}

<div class="container mt-4">
    <h2>Add New Flight</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div class="form-group mb-3">
                    <label asp-for="Airline" class="control-label"></label>
                    <input asp-for="Airline" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="FlightNumber" class="control-label"></label>
                    <input asp-for="FlightNumber" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Origin" class="control-label"></label>
                    <input asp-for="Origin" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Destination" class="control-label"></label>
                    <input asp-for="Destination" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="DepartureTime" class="control-label"></label>
                    <input asp-for="DepartureTime" type="datetime-local" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="ArrivalTime" class="control-label"></label>
                    <input asp-for="ArrivalTime" type="datetime-local" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="SeatsAvailable" class="control-label"></label>
                    <input asp-for="SeatsAvailable" class="form-control" />
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>