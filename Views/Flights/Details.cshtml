@model GBC_Travel_Group_48.Models.Flight

@{
    ViewData["Title"] = "Flight Details";
}

<div class="container mt-4">
    <h2>Flight Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Airline</dt>
        <dd class="col-sm-10">@Model.Airline</dd>

        <dt class="col-sm-2">Flight Number</dt>
        <dd class="col-sm-10">@Model.FlightNumber</dd>

        <dt class="col-sm-2">Origin</dt>
        <dd class="col-sm-10">@Model.Origin</dd>

        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination</dd>

        <dt class="col-sm-2">Departure</dt>
        <dd class="col-sm-10">@Model.DepartureTime.ToString("yyyy-MM-dd HH:mm")</dd>

        <dt class="col-sm-2">Arrival</dt>
        <dd class="col-sm-10">@Model.ArrivalTime.ToString("yyyy-MM-dd HH:mm")</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">$@Model.Price.ToString("N2")</dd>

        <dt class="col-sm-2">Seats Available</dt>
        <dd class="col-sm-10">@Model.SeatsAvailable</dd>
    </dl>
    <div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>