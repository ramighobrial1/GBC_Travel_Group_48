@model IEnumerable<GBC_Travel_Group_48.Models.Flight>

@{
    ViewData["Title"] = "Available Flights";
}

<div class="container mt-4">
    <h2>Available Flights</h2>
    <p class="text-muted">Browse our selection of top-tier flight options for your next trip.</p>

    <!-- Add New Flight Button -->
    <!-- Search Form -->
    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Search by airline, origin, or destination..." />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
    <p>
        <a asp-action="Create" class="btn btn-success">Add New Flight</a>
    </p>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
        <tr>
            <th>Airline</th>
            <th>Flight #</th>
            <th>Origin</th>
            <th>Destination</th>
            <th>Departure</th>
            <th>Arrival</th>
            <th>Price</th>
            <th>Seats</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var flight in Model)
        {
            <tr>
                <td>@flight.Airline</td>
                <td>@flight.FlightNumber</td>
                <td>@flight.Origin</td>
                <td>@flight.Destination</td>
                <td>@flight.DepartureTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@flight.ArrivalTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>$@flight.Price.ToString("N2")</td>
                <td>@flight.SeatsAvailable</td>
                <td>
                    <a asp-action="Details" asp-route-id="@flight.FlightId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@flight.FlightId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@flight.FlightId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>